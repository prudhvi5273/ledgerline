{
  "info": {
    "name": "LedgerLine Financial Core API",
    "description": "Production-grade, verifiable double-entry money movement platform API collection with deterministic row-locking, exact-once idempotency, and auditor reconciliation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "alice_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "auditor_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "source_account_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "dest_account_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as Alice (Account Holder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('alice_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client.alice@example.com\",\n  \"password\": \"SecretPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login as Admin (Root)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin.root@example.com\",\n  \"password\": \"AdminMasterPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login as Auditor (Read-Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('auditor_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"auditor.check@example.com\",\n  \"password\": \"AuditorPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Settlement Accounts",
      "item": [
        {
          "name": "2.1 List Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.length > 0) {",
                  "    pm.collectionVariables.set('source_account_id', jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts",
              "host": ["{{base_url}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "2.2 Open New Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"INR\",\n  \"account_type\": \"USER_CHECKING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts",
              "host": ["{{base_url}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "2.3 Get Account Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{source_account_id}}/balance",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{source_account_id}}", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Money Movement (Idempotent & Double-Entry)",
      "item": [
        {
          "name": "3.1 Deposit Funds (Inflow via Clearing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-deposit-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{source_account_id}}\",\n  \"amount\": \"5000.00\",\n  \"description\": \"Postman API capital deposit\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/deposit",
              "host": ["{{base_url}}"],
              "path": ["transactions", "deposit"]
            }
          }
        },
        {
          "name": "3.2 Execute Transfer (Deterministic Row Locking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-trf-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_account_id\": \"{{source_account_id}}\",\n  \"destination_account_id\": \"{{dest_account_id}}\",\n  \"amount\": \"250.00\",\n  \"description\": \"Inter-account settlement payment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/transfer",
              "host": ["{{base_url}}"],
              "path": ["transactions", "transfer"]
            }
          }
        },
        {
          "name": "3.3 Overdraft-Protected Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-withdraw-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{source_account_id}}\",\n  \"amount\": \"100.00\",\n  \"description\": \"ATM cash withdrawal\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions/withdraw",
              "host": ["{{base_url}}"],
              "path": ["transactions", "withdraw"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Statements & History",
      "item": [
        {
          "name": "4.1 Chronological Running Balance Statement",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{source_account_id}}/statement",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{source_account_id}}", "statement"]
            }
          }
        },
        {
          "name": "4.2 List Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/transactions?limit=20",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Auditor Compliance & Reconciliation",
      "item": [
        {
          "name": "5.1 Invariant Reconciliation Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auditor_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auditor/reconciliation",
              "host": ["{{base_url}}"],
              "path": ["auditor", "reconciliation"]
            }
          }
        },
        {
          "name": "5.2 List Tamper-Evident Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auditor_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auditor/audit-logs?limit=50",
              "host": ["{{base_url}}"],
              "path": ["auditor", "audit-logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "5.3 Export Compliance Audit Pack (JSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auditor_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auditor/export?format=json",
              "host": ["{{base_url}}"],
              "path": ["auditor", "export"],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Admin Management",
      "item": [
        {
          "name": "6.1 List Platform Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "6.2 Freeze Account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FROZEN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/accounts/{{source_account_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["admin", "accounts", "{{source_account_id}}", "status"]
            }
          }
        },
        {
          "name": "6.3 Unfreeze Account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/accounts/{{source_account_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["admin", "accounts", "{{source_account_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "7. System Health",
      "item": [
        {
          "name": "7.1 Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
