# ==========================================
# LedgerLine Environment Configuration
# NOTE: Never commit production credentials!
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=LedgerLine
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_password@localhost:5432/ledgerline_db
# Sync connection string for Alembic migrations:
SYNC_DATABASE_URL=postgresql+psycopg://ledger_user:ledger_password@localhost:5432/ledgerline_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ledgerline.vercel.app

# System Clearing Account ID (Seed/System Account for External Deposits & Withdrawals)
SYSTEM_CLEARING_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
